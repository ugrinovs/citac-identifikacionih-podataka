---
import '../styles/global.css';
import DownloadSplit from '../components/DownloadSplit.astro';

interface Props {
  title: string;
  description: string;
  current?: string;
}

const { title, description, current = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const links = [
  { label: 'Početna', href: base, id: 'home' },
  { label: 'Uputstvo', href: `${base}uputstvo/`, id: 'guide' },
  { label: 'Česta pitanja', href: `${base}faq/`, id: 'faq' },
];
---

<!doctype html>
<html lang="sr-Latn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7faff" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}icon-64.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}icon-512.png`, Astro.site).toString()} />
    <title>{title} · ČIP</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Preskoči na sadržaj</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="header-inner wrap">
          <a class="brand" href={base} aria-label="ČIP — početna">
            <img src={`${base}icon-64.png`} width="38" height="38" alt="" />
            <span>ČIP</span>
          </a>
          <nav class="desktop-nav" aria-label="Glavna navigacija">
            {
              links.map((link) => (
                <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
              ))
            }
          </nav>
          <div class="header-download"><DownloadSplit compact /></div>
          <div class="mobile-actions">
            <a class="mobile-download" href={`${base}verzije/`} aria-current={current === 'releases' ? 'page' : undefined}>Preuzmi</a>
            <details class="mobile-menu">
              <summary aria-label="Meni"><span class="menu-icon" aria-hidden="true"></span></summary>
              <nav aria-label="Mobilna navigacija">
                {links.map((link) => (
                  <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
                ))}
                <a href={`${base}verzije/`} aria-current={current === 'releases' ? 'page' : undefined}>Verzije i instalacija</a>
                <a href={`${base}promene/`}>Šta je novo</a>
              </nav>
            </details>
          </div>
        </div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <div class="wrap footer-inner">
          <div>
            <strong>ČIP</strong>
            <p>Čitač identifikacionih podataka za Mac.</p>
          </div>
          <nav aria-label="Dodatne informacije">
            <a href={`${base}verzije/`}>Verzije</a>
            <a href={`${base}promene/`}>Šta je novo</a>
            <a href={`${base}faq/`}>Pomoć</a>
            <a href={`${base}privatnost/`}>Privatnost</a>
          </nav>
        </div>
        <div class="wrap footer-note">Nezavisna aplikacija. Nije proizvod Ministarstva unutrašnjih poslova Republike Srbije.</div>
      </footer>
    </div>
  </body>
</html>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (mobileMenu) {
    document.addEventListener('pointerdown', (event) => {
      if (!mobileMenu.contains(event.target as Node)) mobileMenu.open = false;
    });
    mobileMenu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        mobileMenu.open = false;
        mobileMenu.querySelector('summary')?.focus();
      }
    });
  }
</script>
