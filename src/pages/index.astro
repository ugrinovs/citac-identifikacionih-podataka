---
import SiteLayout from '../layouts/SiteLayout.astro';
import DownloadSplit from '../components/DownloadSplit.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
import releaseData from '../data/releases.json';

const base = import.meta.env.BASE_URL;
const currentVersion = releaseData.latest?.version;
---

<SiteLayout
  title="Početna"
  description="ČIP je besplatna macOS aplikacija za čitanje podataka sa elektronskih dokumenata. Počinje sa ličnom kartom; saobraćajna dozvola i zdravstvena kartica su u planu."
  current="home"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>ČIP. Dokumenta sa čipom na Macu.</h1>
        <p class="lead">ČIP je čitač identifikacionih podataka. Počinjemo sa ličnom kartom: pročitaj podatke, pripremi prijavu u pregledaču i potpiši ili proveri PDF. Saobraćajna dozvola i zdravstvena kartica su u planu.</p>
        <DownloadSplit />
        <p class="hero-meta">Besplatno · Apple Silicon · macOS 14 ili noviji {currentVersion && `· verzija ${currentVersion}`}</p>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="icon-stage">
          <img src={`${base}icon-512.png`} width="360" height="360" alt="" />
          <span class="gold-dot"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Šta možeš da uradiš</h2>
      <p class="section-intro">Prva verzija fokusirana je na ličnu kartu. Podrška za saobraćajnu dozvolu i zdravstvenu karticu je planirana.</p>
      <div class="feature-grid">
        <div class="feature"><span class="feature-icon" aria-hidden="true">▣</span><h3>Pročitaj podatke</h3><p>Pregledaj podatke, adresu i fotografiju sa lične karte kroz jasan prikaz.</p></div>
        <div class="feature"><span class="feature-icon" aria-hidden="true">✦</span><h3>Pregledaj sertifikate</h3><p>Razlikuj sertifikat za prijavu od sertifikata za potpisivanje.</p></div>
        <div class="feature"><span class="feature-icon" aria-hidden="true">⌁</span><h3>Prijavi se u pregledaču</h3><p>Proveri da li macOS vidi karticu, token i MUP lanac poverenja.</p></div>
        <div class="feature"><span class="feature-icon" aria-hidden="true">✓</span><h3>Radi sa PDF-om</h3><p>Potpiši PDF ključem koji ostaje na kartici i proveri postojeći potpis.</p></div>
      </div>
    </div>
  </section>

  <ScreenshotGallery />

  <section class="section steps-section">
    <div class="wrap">
      <h2>Početak rada</h2>
      <p class="section-intro">Za početak su dovoljni Mac, kompatibilan čitač i lična karta sa čipom.</p>
      <div class="steps">
        <div class="step"><h3>Preuzmi aplikaciju</h3><p>Otvori paket sa strane Verzije, premesti aplikaciju u Applications i prati uputstvo za prvo pokretanje.</p></div>
        <div class="step"><h3>Ubaci ličnu kartu</h3><p>Poveži kompatibilan čitač i izaberi ga u aplikaciji. PIN unosiš samo u macOS dijalogu kada je potreban.</p></div>
        <div class="step"><h3>Izaberi radnju</h3><p>Čitaj podatke, pripremi prijavu u pregledaču ili izaberi PDF za potpis i proveru.</p></div>
      </div>
      <p style="margin:32px 0 0"><a class="text-link" href={`${base}uputstvo/`}>Pročitaj celo uputstvo</a></p>
    </div>
  </section>

  <div class="wrap">
    <section class="cta-band">
      <div><h2>Spremno za tvoj Mac</h2><p>Preuzmi prvo javno izdanje i prati uputstvo za instalaciju.</p></div>
      <DownloadSplit />
    </section>
  </div>
</SiteLayout>
