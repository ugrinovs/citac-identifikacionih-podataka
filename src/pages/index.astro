---
import SiteLayout from '../layouts/SiteLayout.astro';
import DownloadSplit from '../components/DownloadSplit.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
import releaseData from '../data/releases.json';

const base = import.meta.env.BASE_URL;
const currentVersion = releaseData.latest?.version;
const unsignedRelease = releaseData.latest?.unsigned ?? false;
---

<SiteLayout
  title="Početna"
  description="ČIP je besplatna macOS aplikacija za čitanje lične karte, zdravstvene kartice i saobraćajne dozvole Srbije."
  current="home"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Tri kartice. Jedan Mac.</h1>
        <p class="lead">Pročitaj ličnu kartu, zdravstvenu karticu ili saobraćajnu dozvolu. Uz ličnu kartu proveri sertifikate, prijavi se u pregledaču i potpiši PDF.</p>
        <p class="hero-assurance">Nezavisna aplikacija. {unsignedRelease && 'Ovo izdanje nije potpisano Apple Developer ID sertifikatom ni notarizovano. '}<a href={`${base}verzije/`}>Proveri paket i instalaciju pre otvaranja</a>.</p>
        <DownloadSplit />
        <p class="hero-meta">Besplatno · Apple Silicon · macOS 14 ili noviji {currentVersion && `· verzija ${currentVersion}`}</p>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="icon-stage">
          <img src={`${base}icon-512.png`} width="360" height="360" alt="" />
          <span class="gold-dot"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Šta možeš da uradiš</h2>
      <p class="section-intro">ČIP prepoznaje vrstu ubačene kartice i prikazuje funkcije koje su za nju dostupne.</p>
      <div class="feature-grid">
        <div class="feature"><span class="feature-icon" aria-hidden="true">▣</span><h3>Pročitaj podatke</h3><p>Pregledaj ličnu kartu, zdravstvenu karticu ili saobraćajnu dozvolu u prikazu prilagođenom dokumentu.</p></div>
        <div class="feature"><span class="feature-icon" aria-hidden="true">✦</span><h3>Pregledaj sertifikate</h3><p>Razlikuj sertifikat za prijavu od sertifikata za potpisivanje.</p></div>
        <div class="feature"><span class="feature-icon" aria-hidden="true">⌁</span><h3>Prijavi se u pregledaču</h3><p>Proveri da li macOS vidi karticu, token i MUP lanac poverenja.</p></div>
        <div class="feature"><span class="feature-icon" aria-hidden="true">✓</span><h3>Radi sa PDF-om</h3><p>Potpiši PDF ključem koji ostaje na kartici i proveri postojeći potpis.</p></div>
      </div>
    </div>
  </section>

  <section class="section development-section" aria-labelledby="in-development">
    <div class="wrap">
      <p class="development-eyebrow">Podržane kartice</p>
      <h2 id="in-development">Prikaz prilagođen dokumentu</h2>
      <p class="section-intro">Za zdravstvenu karticu ČIP prikazuje podatke sa čipa i, na tvoj zahtev, proverava aktuelni datum overe preko RFZO-a. Za saobraćajnu dozvolu prikazuje podatke o dokumentu i vozilu.</p>
      <p class="development-note">Prijava u pregledaču i potpisivanje PDF-a zahtevaju ličnu kartu sa odgovarajućim sertifikatom. Provera već potpisanog PDF-a dostupna je i bez kartice.</p>
    </div>
  </section>

  <ScreenshotGallery />

  <section class="section steps-section">
    <div class="wrap">
      <h2>Početak rada</h2>
      <p class="section-intro">Za čitanje su dovoljni Mac, kompatibilan čitač i jedna od podržanih kartica.</p>
      <div class="steps">
        <div class="step"><h3>Preuzmi aplikaciju</h3><p>Otvori paket sa strane Verzije, premesti aplikaciju u Applications i prati uputstvo za prvo pokretanje.</p></div>
        <div class="step"><h3>Ubaci karticu</h3><p>Poveži kompatibilan čitač. ČIP prepoznaje vrstu kartice i prikazuje odgovarajuće podatke.</p></div>
        <div class="step"><h3>Izaberi radnju</h3><p>Čitaj podatke ili proveri PDF. Uz ličnu kartu možeš pripremiti prijavu u pregledaču i potpisati PDF.</p></div>
      </div>
      <p style="margin:32px 0 0"><a class="text-link" href={`${base}uputstvo/`}>Pročitaj celo uputstvo</a></p>
    </div>
  </section>

  <div class="wrap">
    <section class="cta-band">
      <div><h2>Spremno za tvoj Mac</h2><p>Preuzmi aktuelno izdanje. <a href={`${base}verzije/`}>Pogledaj otisak i uputstvo za instalaciju</a> pre otvaranja paketa.</p></div>
      <DownloadSplit />
    </section>
  </div>
</SiteLayout>
