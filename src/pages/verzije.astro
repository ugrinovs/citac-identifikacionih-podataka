---
import SiteLayout from '../layouts/SiteLayout.astro';
import releaseData from '../data/releases.json';

interface Release { version: string; publishedAt: string; downloadUrl: string; size?: string; notes: string; sha256?: string | null; checksumUrl?: string | null; unsigned?: boolean; }
const base = import.meta.env.BASE_URL;
const releases = releaseData.releases as Release[];
---

<SiteLayout title="Sve verzije" description="Preuzmi aktuelno i prethodna izdanja ČIP-a za macOS." current="releases">
  <header class="page-heading"><div class="wrap"><h1>Sve verzije</h1><p>Instalacioni paketi, datumi izdanja i otisci za proveru. Pre otvaranja paketa pročitaj <a href={`${base}uputstvo/#instalacija`}>uputstvo za instalaciju</a>.</p></div></header>
  <section class="section"><div class="wrap">
    {releases.length ? (
      <div class="release-list">
        {releases.map((release) => (
          <article class="release-card">
            <h2>Verzija {release.version}</h2>
            <p>Objavljeno {release.publishedAt}{release.size ? ` · ${release.size}` : ''}</p>
            {release.unsigned && <p class="release-warning">Ovo izdanje nema Apple Developer ID potpis ni notarizaciju. Proveri paket pre prvog otvaranja.</p>}
            <div class="release-actions">
              <a class="release-download" href={release.downloadUrl}>Preuzmi za macOS</a>
              {release.checksumUrl && <a href={release.checksumUrl}>Preuzmi .sha256 fajl</a>}
            </div>
            {release.sha256 ? (
              <div class="release-checksum">
                <strong>SHA-256 otisak instalacionog paketa</strong>
                <code>{release.sha256}</code>
                <p>U Terminalu pokreni <code>shasum -a 256 {new URL(release.downloadUrl).pathname.split('/').at(-1)}</code> i uporedi dobijeni otisak sa ovim. <a href={`${base}uputstvo/#instalacija`}>Koraci za instalaciju</a></p>
              </div>
            ) : (
              <p class="release-checksum-missing">SHA-256 otisak nije naveden za ovo izdanje.</p>
            )}
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state"><h2>Prva javna verzija je u pripremi</h2><p>Preuzimanje će se pojaviti ovde kada instalacioni paket prođe završne provere.</p></div>
    )}
  </div></section>
</SiteLayout>
