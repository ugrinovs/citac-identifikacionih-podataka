---
import SiteLayout from '../layouts/SiteLayout.astro';
import releaseData from '../data/releases.json';

interface Release { version: string; publishedAt: string; downloadUrl: string; size?: string; notes: string; }
const base = import.meta.env.BASE_URL;
const releases = releaseData.releases as Release[];
---

<SiteLayout title="Sve verzije" description="Preuzmi aktuelno i prethodna izdanja ČIP-a za macOS.">
  <header class="page-heading"><div class="wrap"><h1>Sve verzije</h1><p>Instalacioni paketi i datumi izdanja. Prva izdanja neće imati Apple Developer ID potpis ni notarizaciju; pročitaj <a href={`${base}uputstvo/#instalacija`}>uputstvo za instalaciju</a> pre preuzimanja.</p></div></header>
  <section class="section"><div class="wrap">
    {releases.length ? <div class="release-list">{releases.map((release) => <article class="release-card"><h2>Verzija {release.version}</h2><p>Objavljeno {release.publishedAt}{release.size ? ` · ${release.size}` : ''}</p><a href={release.downloadUrl}>Preuzmi za macOS</a></article>)}</div> : <div class="empty-state"><h2>Prva javna verzija je u pripremi</h2><p>Preuzimanje će se pojaviti ovde kada instalacioni paket prođe završne provere.</p></div>}
  </div></section>
</SiteLayout>
